#include "portable/game/resources/database.h"
#include "portable/whole_program/window_source_globals.h"
#include "portable/whole_program/platform/dos_memory.h"

#include <stdarg.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

struct Rect { int16_t left, top, right, bottom; };
struct Pt { int16_t x, y; };
struct Rect g_635C;
struct Pt fd_50F6_47DA;

extern int16_t win_LoadAllWindows(void);
extern struct Rect win_offsets[45];
extern struct Pt fd_50F6_47DA;
extern void font_InitFonts(void);
extern void win_LockInit(void);
extern char **db_LoadObject(int16_t id, int16_t kind);
extern char *f_171C_1B84(char **handle);
extern void f_171C_1BBA(char **handle);
extern void db_PurgeObject(int16_t id, int16_t kind);
extern void db_UnhookObject(int16_t id, int16_t kind);
extern void f_208F_0419(struct Pt *size, int16_t id);
extern void Punt(char *format, ...);

static PortableDatabase database;
static struct {
    int16_t id;
    int16_t kind;
    char *data;
    PortableDbRecord record;
    int active;
} slots[4];
static char events[256][48];
static size_t event_count;
static int16_t loaded_windows[40];
static size_t loaded_count;
static int failure;

static void event(const char *name, int a, int b)
{
    if (event_count >= sizeof(events) / sizeof(events[0])) {
        failure = 1;
        return;
    }
    (void)snprintf(events[event_count], sizeof(events[event_count]),
                   "%s:%d:%d", name, a, b);
    ++event_count;
}

static int check(int ok, const char *message)
{
    if (!ok) {
        fprintf(stderr, "FAIL: %s\n", message);
        return 0;
    }
    return 1;
}

void font_InitFonts(void) { event("fonts", 0, 0); }
void win_LockInit(void) { event("lock-init", 0, 0); }

char **db_LoadObject(int16_t id, int16_t kind)
{
    size_t i;
    event("load", id, kind);
    for (i = 0; i < sizeof(slots) / sizeof(slots[0]); ++i) {
        if (!slots[i].active) {
            PortableDbRecord record = {0};
            if (portable_db_load(&database, id, kind, &record) != PORTABLE_DB_OK)
                return NULL;
            slots[i].id = id;
            slots[i].kind = kind;
            slots[i].record = record;
            slots[i].data = (char *)record.data;
            slots[i].active = 1;
            return &slots[i].data;
        }
    }
    failure = 1;
    return NULL;
}

char *f_171C_1B84(char **handle)
{
    return handle == NULL ? NULL : *handle;
}

void f_171C_1BBA(char **handle)
{
    (void)handle;
}

void db_PurgeObject(int16_t id, int16_t kind)
{
    size_t i;
    event("purge", id, kind);
    for (i = 0; i < sizeof(slots) / sizeof(slots[0]); ++i) {
        if (slots[i].active && slots[i].id == id && slots[i].kind == kind) {
            portable_db_record_free(&slots[i].record);
            memset(&slots[i], 0, sizeof(slots[i]));
            return;
        }
    }
    failure = 1;
}

void db_UnhookObject(int16_t id, int16_t kind)
{
    event("unhook", id, kind);
}

void f_208F_0419(struct Pt *size, int16_t id)
{
    event("bitmap-size", id, 0);
    size->x = 16;
    size->y = 16;
}

void Punt(char *format, ...)
{
    va_list ap;
    va_start(ap, format);
    fputs("unexpected Punt: ", stderr);
    vfprintf(stderr, format, ap);
    fputc('\n', stderr);
    va_end(ap);
    failure = 1;
}

/* The test boundary stops only after the real source loader chooses a window
 * and before entering that window's separate load/repoint lifecycle. */
void test_win_LoadWindow(int16_t id)
{
    if (loaded_count < sizeof(loaded_windows) / sizeof(loaded_windows[0]))
        loaded_windows[loaded_count++] = id;
    else
        failure = 1;
    event("window", id, 0);
}

#define win_LoadWindow test_win_LoadWindow
@@SOURCE_FUNCTION@@
#undef win_LoadWindow

int main(int argc, char **argv)
{
    PortableDbRecord r80 = {0}, r81 = {0}, r83 = {0}, profile = {0};
    size_t i, expected_loaded = 0;

    if (argc != 2) return 2;
    if (!check(portable_db_open(&database, argv[1]) == PORTABLE_DB_OK,
               "open actual HCEGANT resource database")) return 1;
    if (!check(portable_db_load(&database, 0x80, 0, &r80) == PORTABLE_DB_OK &&
               portable_db_load(&database, 0x81, 0, &r81) == PORTABLE_DB_OK &&
               portable_db_load(&database, 0x83, 0, &r83) == PORTABLE_DB_OK &&
               portable_db_load(&database, 0, 9, &profile) == PORTABLE_DB_OK,
               "inspect actual source count/color/purge records")) return 1;
    if (!check(r80.size == 20 && r81.size == 96 && r83.size == 40,
               "resource extents match source loader reads")) return 1;
    if (!check(profile.size >= 0x140,
               "actual profile-kind-9 offset record covers source 0x140-byte copy")) return 1;

    sim_window_source_set_profile(0);
    g_635C.left = INT16_MIN;
    g_635C.top = INT16_MIN;
    g_635C.right = INT16_MIN;
    g_635C.bottom = INT16_MIN;
    if (!check(win_LoadAllWindows() == 1,
               "execute converted source win_LoadAllWindows")) return 1;
    if (!check(!failure, "all resource lifecycle calls succeeded")) return 1;

    if (!check(win_numOfWindows == 34 && win_numOfColors == 16 &&
               win_numOfGroups == 6,
               "source loader publishes actual resource-0x80 counts")) return 1;
    if (!check(win_colors != NULL && sim_window_source_colors_size() == 96 &&
               memcmp(win_colors, r81.data, 96) == 0,
               "original resource-0x81 source copy fills owned color rows")) return 1;
    if (!check(memcmp(win_offsets, profile.data, 0x140) == 0 &&
               win_offsets[40].left == INT16_MIN &&
               win_offsets[44].bottom == INT16_MIN,
               "source profile offsets copy exactly 40 records and retain five sentinels")) return 1;
    for (i = 0; i < 45; ++i) {
        if (!check(win_drawHooks[i] == NULL,
                   "source loader clears native hook slot")) return 1;
    }
    for (i = 0; i < (size_t)win_numOfWindows; ++i) {
        if (r83.data[i] == 0) {
            if (!check(expected_loaded < loaded_count &&
                       loaded_windows[expected_loaded] == (int16_t)(i << 8),
                       "source purge loop loads each actual zero entry in order")) {
                fprintf(stderr, "purge index=%zu payload=%u seen=%zu loaded=%zu first=%d\n",
                        i, (unsigned)r83.data[i], expected_loaded, loaded_count,
                        loaded_count == 0 ? -1 : loaded_windows[0]);
                return 1;
            }
            ++expected_loaded;
        }
    }
    if (!check(expected_loaded == loaded_count,
               "source purge loop skips every nonzero entry")) return 1;
    if (!check(event_count >= 11 &&
               strcmp(events[0], "fonts:0:0") == 0 &&
               strcmp(events[1], "lock-init:0:0") == 0 &&
               strcmp(events[2], "load:0:9") == 0 &&
               strcmp(events[3], "purge:0:9") == 0 &&
               strcmp(events[4], "bitmap-size:111:0") == 0 &&
               strcmp(events[5], "load:128:0") == 0 &&
               strcmp(events[6], "purge:128:0") == 0 &&
               strcmp(events[7], "load:129:0") == 0 &&
               strcmp(events[8], "purge:129:0") == 0 &&
               strcmp(events[9], "load:131:0") == 0 &&
               strcmp(events[10], "purge:131:0") == 0,
               "resource reads and source setup calls retain original order")) {
        for (i = 0; i < event_count && i < 12; ++i)
            fprintf(stderr, "event[%zu]=%s\n", i, events[i]);
        return 1;
    }

    printf("PASS converted win_LoadAllWindows: profile=%d windows=%d colors=%d groups=%d loaded=%zu calls=%zu\n",
           g_5A97, win_numOfWindows, win_numOfColors, win_numOfGroups,
           loaded_count, event_count);
    sim_window_source_release_colors();
    portable_db_record_free(&r80);
    portable_db_record_free(&r81);
    portable_db_record_free(&r83);
    portable_db_record_free(&profile);
    portable_db_close(&database);
    return 0;
}
