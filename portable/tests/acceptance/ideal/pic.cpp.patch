+/* Move only to the next event or millisecond. The caller runs any IRQ body
+ * to completion before moving again. CPU budgets never advance this clock. */
+double IdealNext(double target) {
+    double next=target;
+    if (next>(double)PIC_Ticks+1) next=(double)PIC_Ticks+1;
+    if (pic_queue.next_entry) {
+        double due=(double)PIC_Ticks+pic_queue.next_entry->index;
+        if(due<next) next=due;
+    }
+    if(next<(double)PIC_FullIndex()) next=PIC_FullIndex();
+    return next;
+}
+void IdealMove(double target) {
+    double next=IdealNext(target);
+    if(next<(double)PIC_FullIndex()-1e-8) { LOG_MSG("IDEAL backwards %.12f -> %.12f",(double)PIC_FullIndex(),next);abort(); }
+    if(next>=(double)PIC_Ticks+1) { IdealFraction=0;TIMER_AddTick(); }
+    else IdealFraction=next-(double)PIC_Ticks;
+}
+void IdealStart() {
+    double fraction=PIC_TickIndex();
+    for(PICEntry *entry=pic_queue.next_entry;entry;entry=entry->next) entry->index-=fraction;
+    PIC_Ticks=0;IdealFraction=0;IdealActive=true;
+}
