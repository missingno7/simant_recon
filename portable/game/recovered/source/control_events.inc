void  BoundPointToTri(struct Pt  *pt, struct Rect  *r)
{
    int16_t top;
    int16_t bottom;
    int16_t right;
    int16_t left;
    int16_t mid;
    int16_t x;
    int16_t y;
    int16_t edge;

    top = r->top;
    bottom = r->bottom - 1;
    right = r->right;
    left = r->left;
    mid = (right + left) / 2;
    x = pt->x;
    y = pt->y;
    if (y > bottom)
        y = bottom;
    else if (y < top)
        y = top;
    edge = (int32_t)(left - mid) * (y - bottom) / (int32_t)(bottom - top) + left;
    if (edge > x)
        x = edge;
    else {
        edge = (int32_t)(mid - right) * (y - top) / (int32_t)(top - bottom) + mid;
        if (edge < x)
            x = edge;
    }
    pt->x = x;
    pt->y = y;
}

