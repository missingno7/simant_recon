    int16_t bottom;
    int16_t right;
    int16_t left;
    int16_t mid;
    int16_t x;
    int16_t y;

    top = r->top;
    bottom = r->bottom;
    right = r->right;
    left = r->left;
    mid = (right + left) / 2;
    x = pt->x;
    y = pt->y;
    if (y >= bottom || y < top)
        return 0;
    if ((int32_t)(left - mid) * (y - bottom) / (int32_t)(bottom - top) + left > x)
        return 0;
    if ((int32_t)(mid - right) * (y - top) / (int32_t)(top - bottom) + mid < x)
