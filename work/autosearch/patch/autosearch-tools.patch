+NL = chr(10)
+SCAFF_BLOCK_RE = re.compile(r"/\*\s*SCAFFOLD BEGIN.*?\*/[ \t]*\n?(.*?)/\*\s*SCAFFOLD END\s*\*/[ \t]*\n?", re.S)
