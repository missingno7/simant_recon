+            return C.P_POSTFIX
+        if isinstance(p, C.Call):
+            return C.P_POSTFIX if n is p.f else C.P_ASSIGN
+        if isinstance(p, C.Index):
+            return C.P_POSTFIX if n is p.a else C.P_COMMA
+        if isinstance(p, C.Comma):
+            return C.P_ASSIGN
+        if isinstance(p, C.Decl):
+            return C.P_ASSIGN
+        return C.P_COMMA
