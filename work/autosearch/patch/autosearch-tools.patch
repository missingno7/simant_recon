+        def overlap(x, y):
+            if x == y:
+                return True
+            a, b = (x, y) if len(x) < len(y) else (y, x)
+            if b.startswith(a) and b[len(a)] in ".[-":
+                return True
+            # element accesses of one array may alias whatever their indices
+            return ("[" in a or "[" in b) and a.split("[")[0] == b.split("[")[0]
