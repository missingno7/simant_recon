+        nx = blk.items[i + 1]
+        if not (isinstance(st, C.ExprStmt) and isinstance(nx, C.ExprStmt)):
+            continue
+        ra, wa, ca = reads_writes(cx, st)
+        rb, wb, cb = reads_writes(cx, nx)
+        if ca and cb:
