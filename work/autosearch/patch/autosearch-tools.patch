+def case_groups(sw):
+    """[(start, end, [items])] of a switch body: each group runs from a case label to the next."""
+    if not isinstance(sw.body, C.Block):
+        return []
+    groups = []
+    for it in sw.body.items:
+        if isinstance(it, C.Case):
