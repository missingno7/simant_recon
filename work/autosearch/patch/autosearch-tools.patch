+            out.append("/* SCAFFOLD BEGIN: (split from a shared block by autosearch) */" + NL)
+            out.append(inner[fn.head_s:fn.e] + NL + "/* SCAFFOLD END */")
+            pos = fn.e
+        out.append(inner[pos:])
+        return text[:m.start()] + "".join(out) + text[m.end():]
+    return text
