+        else:
+            new = [p if p == "..." else f"{p}{'' if p.endswith('*') else ' '}{'p%d' % k}" for k, p in enumerate(params)]
+            yield Move("PROTO-NAMES", f"{name} named", [(lp + 1, rp, ", ".join(new))])
