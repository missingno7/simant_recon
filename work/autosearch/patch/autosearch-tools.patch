+    for blk, i, st in cx.lists():
+        if not (isinstance(st, C.ExprStmt) and isinstance(st.x, C.Assign) and st.x.op == "="
+                and isinstance(C.strip_paren(st.x.l), (C.Member, C.Index, C.Unary))):
