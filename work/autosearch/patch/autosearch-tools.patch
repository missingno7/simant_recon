+        if "..." not in params and len(params) >= 2:
+            yield Move("PROTO-TYPE", f"{name} variadic", [(lp + 1, rp, params[0] + ", ...")])
+        yield Move("PROTO-TYPE", f"{name} unprototyped", [(lp + 1, rp, "")])
