# SIMANT.LNK -- RTLink/Plus freeformat link script DERIVED for the original SIMANT.EXE (worker rtlink, 2026-09-30)
# Status of each directive (E = reproduced exactly by an independent RTLink/Plus 6.10 trial link, t3;
#   O = read from the original = oracle-derived script fact; H = hypothesis).
#   E  4 areas (BEGINAREA..ENDAREA) with 4/8/8/7 sections: section load segments relative to the first area,
#      section ids (index+2), father FFFF, flags 05/04/01, memory sizes and relocation counts of every
#      section built only from real objects are identical (logs/t3_sections.txt).
#   E  S00 PRELOAD  -> section flag 0x05 (preload|cache); other overlays 0x04 (cache is the default);
#      the "preloaded data" section 27 (flag 0x01) is created by RTLink itself (far data + DGROUP).
#   E  RELOAD FAR 400 -> $$OVLINFO ih_flags=0001 and reload stack 0x1800 bytes (hex 400 entries x 6);
#      it selects the RELOAD manager variant $$RTLOVLINITR (no DEBUG, no CODEVIEW) -- as in SIMANT.EXE.
#   E  ALWAYS (vector order) -> vectors 1..18 are created first, in the listed order (not sorted).
#   O  NEVER -> no vector for these overlay procedures although they are referenced from another unit
#      (RTLink/Plus 6.10 vectors every cross-unit reference, incl. far pointers in data, by default).
#   E  remaining vectors: first reference in object-processing order (pass 2).
#   H  CACHE: the manager contains the real cache (rcache/rcache_m/rtalloc/cacheenv: EMMXXXX0, RTOVEXP/
#      RTOVEXT/RTOVCONV); a CACHE directive pulls exactly these modules in 6.10; parameters unknown.
#   O  FILE order = address order of the original modules (root, then per section); 83 of 85 complete-TU
#      objects land at their accepted addresses in the trial.  Open: root:19A9 starts at the odd address
#      0x19A95 although MSC code segments are WORD aligned; root:2CFB (MEMHOOK_TEXT) lies after the
#      runtime _TEXT, so its object was read after the library search (or had another class).
#   Unreconstructed/partial modules are listed by frame (F_xxxx) -- they do not exist yet.

OUTPUT SIMANT
MAP = SIMANT S,N,A,L,V,X
NODEFLIB
LIBRARY LLIBCR, LIBH
RELOAD FAR 400
CACHE EXPANDED 100.%   # H
CACHE EXTENDED 100.%   # H
FILE R0000, R004A, R0093, R00BA
FILE F_00DEA, R00DF, R00F8, R015B, R0244
FILE F_0250E, R075B, R078E, R0798, R0894, R0AD9
FILE R0BE8, F_0CDB0, R0DEF, F_0E2EA, R0EC1
FILE R0F3F, F_10F7E, R1383, R1496, F_14EE2, R15D9, R15F8
FILE R1629, R1699, R16B5, F_171C2, R194D
FILE R1959, R195A, F_19864, R19A9, R19DC, R1A28
FILE R1A53, F_1A96C, R1B05, R1B28, R1B4E
FILE R1B73, F_1C62C, R1CE2, R1D8E, F_1E576, R1F58
FILE R1F66, R1F80, R1FAA, R1FBD, R1FD2
FILE R205F, R208F, F_20E80, R218D, R21FA
FILE R22BF, F_23AE4, F_23E60, R24AB, R24FA, F_25056, F_259DE, R25E7
FILE R2650, R2662, R277D, R277E, F_2815A, R283E
FILE F_284A4, R28BC, F_290DE, F_293A6, F_295CA, R29B8
FILE R29BF, F_29D6A, R29F0
FILE <far data / DGROUP modules>   # data TUs: D3D57, D3E1D, D55B3042, D55B3064, D55B30B8
BEGINAREA
  SECTION FILE S00126, S001AD, S001AAB4, S005A6 PRELOAD
  SECTION FILE S01126, S0128E, S012B5
  SECTION FILE S02126
  SECTION FILE S03126, S03253, S03258
ENDAREA
BEGINAREA
  SECTION FILE F_35F50
  SECTION FILE S055F5, F_36634
  SECTION FILE F_35F50
  SECTION FILE S075F5
  SECTION FILE F_35F50
  SECTION FILE F_35F50, S096EE
  SECTION FILE F_35F50
  SECTION FILE S115F5
ENDAREA
BEGINAREA
  SECTION FILE F_384C0
  SECTION FILE F_384C0
  SECTION FILE F_384C0
  SECTION FILE F_384C0
  SECTION FILE S1684C
  SECTION FILE F_384C0
  SECTION FILE S1884C
  SECTION FILE S1984C
ENDAREA
BEGINAREA
  SECTION FILE S209C7, S209F1
  SECTION FILE S219C7
  SECTION FILE S229C7, S22BBD
  SECTION FILE F_39C70
  SECTION FILE F_39C70
  SECTION FILE F_39C70, F_3BA48
  SECTION FILE S269C7
ENDAREA
FILE R2CFB   # O: MEMHOOK_TEXT after the runtime _TEXT (placement open)
ALWAYS _f_00BA_01C3, _win_DrawCasteWindow, _f_0250_0EDA, _win_DrawHistoryWindow, _win_DrawInfoWindow, _o12_384C_1035, _win_DrawModeWindow, _win_DrawYardWindow, _f_00BA_0228, _f_00BA_0211, _o02_3126_0000, _o01_3126_0068, _o01_3126_007D, _o00_31AD_1AE7, _o00_31AD_2AE5, _o00_31AD_2AB4, _o03_3126_0140, _o01_3126_010A
NEVER "@o26_39C7_022F", _AddRock3, _AddRock5, _AddRocks, _CarpetFloorL, _CarpetFloorR, _ClearLifeB, _ClearLifeR
NEVER _ConnectAll, _ConnectWall, _DoTool, _DropWall, _ExpAddAnt, _ExpAddFood, _ExpDig, _ExpIncSmell
NEVER _ExpKillAnts, _FillDirtB, _FillDirtR, _FillMap, _FillMapLegs, _FloorTiles, _GetSM, _IncFoodHere
NEVER _IsItWall, _IsValidSLoc, _LionDialog, _MakeClip, _MakeHousePatch, _MakeKitchenWall, _MakeKnob, _MakeLint2
NEVER _MakeOutletH, _MakeOutletV, _MakePenny, _MakePlugH, _MakePlugV, _MakeSink, _MakeYardPatch, _ReDrawMapEdit
NEVER _ReadConfig, _ReadWord, _SetGoalsY, _SetSM, _SkipWords, _SmoothACell, _SmoothMany, _SpecialXfer
NEVER _TileFrame1, _TileFrame2, _WallNeighbors, _YellowBirth, _YellowHelp, _o00_31AD_0004, _o00_31AD_0122, _o00_31AD_037C
NEVER _o00_31AD_0522, _o00_31AD_0550, _o00_31AD_062A, _o00_31AD_062E, _o00_31AD_0632, _o00_31AD_0636, _o00_31AD_063C, _o00_31AD_0647
NEVER _o00_31AD_0CF9, _o00_31AD_0D06, _o00_31AD_11FB, _o00_31AD_1206, _o00_31AD_1213, _o00_31AD_1481, _o00_31AD_148C, _o00_31AD_1499
NEVER _o00_31AD_1659, _o00_31AD_166A, _o00_31AD_168C, _o00_31AD_16A9, _o00_31AD_18BA, _o00_31AD_1950, _o00_35A6_0006, _o00_35A6_0007
NEVER _o00_35A6_0177, _o00_35A6_02FD, _o00_35A6_0406, _o01_3126_0000, _o01_32B5_000E, _o01_32B5_000F, _o01_32B5_00AA, _o01_32B5_0152
NEVER _o01_32B5_024F, _o03_3258_040C, _o03_3258_040D, _o03_3258_04CE, _o03_3258_05A7, _o03_3258_175F, _o09_36EE_000A, _o09_36EE_003C
NEVER _o09_36EE_0092, _o19_384C_0246, _o19_384C_0320, _o19_384C_0383, _o20_39C7_0007, _o20_39C7_02A8, _processExp, _processSpider
