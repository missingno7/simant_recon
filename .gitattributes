src/** text eol=lf
include/** text eol=lf
*.py text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.md text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
portable/**/*.c text eol=lf
portable/**/*.h text eol=lf
portable/runtime/bios-reference/** -text
portable/tests/runtime/*.txt text eol=lf

# Current validator and proof identities retain their exact recorded bytes.
tools/** -text
tests/** -text
layout/manifest.json -text
docs/progress.json -text
evidence/promotions.jsonl -text
evidence/canonical/** -text

# Locked historical metadata has a recorded CRLF working-file identity.
layout/functions.json text eol=crlf
layout/oracle.lock.json text eol=crlf
layout/symbols.json text eol=crlf
layout/toolchain.json text eol=crlf
