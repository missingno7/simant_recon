src/** text eol=lf
include/** text eol=lf
*.py text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.md text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

# Archived proof inputs are hashed as file bytes. Preserve their recorded
# line endings so checkout cannot silently invalidate a certificate or ledger.
evidence/behavior/** -text
tools/archive/** -text
tools/behavior_suites/archive/** -text
work/takeover/behavioral-oracle/** -text
work/takeover/hardtail/** -text
work/takeover/compiler-ir/** -text
# Validation receipts pin these files directly, including generated metadata.
tools/** -text
tests/** -text
layout/manifest.json -text
docs/progress.json -text
evidence/promotions.jsonl -text
# These immutable/existing metadata blobs remain LF in Git. Their recorded
# working-file identities use CRLF; make checkout reproduce those identities
# on every host without editing the lock or rewriting historical evidence.
layout/functions.json text eol=crlf
layout/oracle.lock.json text eol=crlf
layout/symbols.json text eol=crlf
layout/toolchain.json text eol=crlf
# Native proof archives also pin exact file bytes, including scripts and logs.
portable/evidence/** -text
portable/tests/**/evidence/** -text
portable/tests/whole_program/runtime_flow_v13/** -text
portable/tests/whole_program/text_bitmap/bridge-payload-v1-inputs/** -text
portable/tests/whole_program/text_bitmap/caption-runtime-v14/** -text
portable/tests/whole_program/s26_window_object_views_v1/fixtures/** -text
portable/tests/whole_program/title_drag_s26_v17/** -text
